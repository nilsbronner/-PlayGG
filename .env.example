# URL publique du site (utilisée pour construire le lien de confirmation par email
# et l'URL du badge). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://playgg.fr

# Projet Supabase (Settings > API dans le dashboard Supabase)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé "service_role" — SECRÈTE, jamais exposée au client, utilisée uniquement
# dans les Server Actions / Route Handlers pour écrire dans la base.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com) — email transactionnel du double opt-in
RESEND_API_KEY=
# Adresse d'expédition, doit appartenir à un domaine vérifié dans Resend
RESEND_FROM_EMAIL="#PlayGG <charte@playgg.fr>"
